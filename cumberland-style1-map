      {c:"#d1d5db",t:"No data"},
    ];
  } else if(mode.startsWith("s")){
    title="Swing (pp, D+)";
    rows=[
      {c:"#7f1d1d",t:"R 30+"},{c:"#b91c1c",t:"R 20–30"},{c:"#ef4444",t:"R 10–20"},{c:"#fca5a5",t:"R 4–10"},{c:"#fee2e2",t:"R 0–4"},
      {c:"#f3f4f6",t:"0"},
      {c:"#dbeafe",t:"D 0–4"},{c:"#93c5fd",t:"D 4–10"},{c:"#3b82f6",t:"D 10–20"},{c:"#1d4ed8",t:"D 20–30"},{c:"#1e3a8a",t:"D 30+"},
      {c:"#d1d5db",t:"No data"},
    ];
  } else if(mode==="inc"){
    title="Avg HH income (quantiles)";
    rows=[{c:incomePalette[0],t:"Lowest"},{c:incomePalette[1],t:"Low"},{c:incomePalette[2],t:"Mid"},{c:incomePalette[3],t:"High"},{c:incomePalette[4],t:"Highest"},{c:"#d1d5db",t:"No data"}];
  } else if(mode==="ba"||mode==="nw"){
    title = (mode==="ba") ? "% Bachelor’s+ (quantiles)" : "% Non-White (quantiles)";
    rows=[{c:pctPalette[0],t:"Lowest"},{c:pctPalette[1],t:"Low"},{c:pctPalette[2],t:"Mid"},{c:pctPalette[3],t:"High"},{c:pctPalette[4],t:"Highest"},{c:"#d1d5db",t:"No data"}];
  } else if(mode==="maj"){
    title="Racial plurality";
    rows=[{c:"#2563eb",t:"White"},{c:"#16a34a",t:"Black"},{c:"#f59e0b",t:"Asian"},{c:"#dc2626",t:"Latino"},{c:"#d1d5db",t:"No data"}];
  }
  el.innerHTML = `<div class="legend-title">${title}</div>` + rows.map(r=>`<div class="legend-row">${sw(r.c)}<span>${r.t}</span></div>`).join("");
}

function refreshLayer(){ if(!geoLayer) return; geoLayer.setStyle(styleFeature); setLegend(currentMode); }

async function init(){
  const note=document.getElementById("note");
  try{
    await window.__loadLeaflet();
    if(!window.L){ note.classList.add("error"); note.textContent="Leaflet failed to load (CDN blocked/offline)."; return; }
  } catch(e){ note.classList.add("error"); note.textContent="Leaflet failed to load."; return; }

  incomeBreaks=computeBreaks(getAvgHHIncome);
  baBreaks=computeBreaks(getBachelorsPct);
  nwBreaks=computeBreaks(getNonWhitePct);

  map=L.map('map',{zoomControl:true});
  base=L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png',{attribution:'&copy; OpenStreetMap contributors &copy; CARTO',maxZoom:19}).addTo(map);

  geoLayer=L.geoJSON(GEOJSON,{style:styleFeature,onEachFeature:bindFeature}).addTo(map);

  function doInitialFit(){
    let saw=false, minLat=90,maxLat=-90,minLng=180,maxLng=-180;
    const plausible=(lat,lng)=>(isFinite(lat)&&isFinite(lng)&&!(lat===0&&lng===0)&&lat>39.5&&lat<41.0&&lng>-78.5&&lng<-76.0);
    try{
      for(const f of (GEOJSON.features||[])){
        const g=f.geometry; if(!g) continue;
        const walk=(coords)=>{
          if(!coords) return;
          if(typeof coords[0]==="number" && typeof coords[1]==="number"){
            const lng=coords[0], lat=coords[1];
            if(plausible(lat,lng)){
              saw=true;
              if(lat<minLat) minLat=lat; if(lat>maxLat) maxLat=lat;
              if(lng<minLng) minLng=lng; if(lng>maxLng) maxLng=lng;
            }
          } else { for(const c of coords) walk(c); }
        };
        walk(g.coordinates);
      }
    } catch(e){ console.warn("Bounds scan failed:",e); }
    if(saw){ map.fitBounds([[39.944077, -77.627509], [40.328484, -76.858833]],{padding:[12,12]}); }
    else { map.setView([40.20,-77.20],10); }
  }

  doInitialFit();
  setTimeout(()=>{ map.invalidateSize(); doInitialFit(); },150);
  window.addEventListener("load",()=>{ setTimeout(doInitialFit,50); });

  setLegend(currentMode);

  document.querySelectorAll('input[name="layer"]').forEach(r=>{
    r.addEventListener('change',(e)=>{ currentMode=e.target.value; refreshLayer(); });
  });

  setTimeout(()=>map.invalidateSize(),50);
}
init();
</script>
