  };

  function loadCSS(url) {
    return new Promise((res, rej) => {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = url;
      link.onload = () => res(url);
      link.onerror = () => rej(url);
      document.head.appendChild(link);
    });
  }

  function loadJS(url) {
    return new Promise((res, rej) => {
      const s = document.createElement('script');
      s.src = url;
      s.defer = true;
      s.onload = () => res(url);
      s.onerror = () => rej(url);
      document.head.appendChild(s);
    });
  }

  async function loadLeaflet() {
    for (const c of leaf.css) { try { await loadCSS(c); break; } catch(e) {} }
    for (const j of leaf.js) { try { await loadJS(j); break; } catch(e) {} }
  }

  window.__loadLeaflet = loadLeaflet;
})();
</script>
