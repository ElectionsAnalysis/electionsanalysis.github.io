function isNum(x) { return typeof x === "number" && isFinite(x); }
function numOrNull(x) { const n = (typeof x === "string") ? Number(x) : x; return isNum(n) ? n : null; }
function pct2party(d, r) { d=numOrNull(d); r=numOrNull(r); if(d===null||r===null) return null; const t=d+r; if(!isFinite(t)||t<=0) return null; return 100*d/t; }
function marginSigned(d, r) { d=numOrNull(d); r=numOrNull(r); if(d===null||r===null) return null; const t=d+r; if(!isFinite(t)||t<=0) return null; return 100*(d-r)/t; }
function fmtPct(x) { x=numOrNull(x); return (x===null) ? "n/a" : (x.toFixed(1)+"%"); }
function fmtPP(x) { x=numOrNull(x); if(x===null) return "n/a"; const s=(x>0)?"+":""; return s+x.toFixed(1)+" pp"; }
function fmtMoney(x) { x=numOrNull(x); if(x===null) return "n/a"; try { return x.toLocaleString(undefined,{style:"currency",currency:"USD",maximumFractionDigits:0}); } catch(e){ return "$"+Math.round(x); } }
function fmtMarginParty(m) {
  m=numOrNull(m); if(m===null) return "n/a";
  const s=Math.abs(m).toFixed(1);
  if(m>0) return `<span style="color:#1d4ed8;font-weight:700;">D + ${s}</span>`;
  if(m<0) return `<span style="color:#b91c1c;font-weight:700;">R + ${s}</span>`;
  return `<span style="color:#111827;font-weight:700;">Tied</span>`;
}
function fmtSwingParty(s) {
  s=numOrNull(s); if(s===null) return "n/a";
  const a=Math.abs(s).toFixed(1);
  if(s>0) return `<span style="color:#1d4ed8;font-weight:700;">D + ${a}</span>`;
  if(s<0) return `<span style="color:#b91c1c;font-weight:700;">R + ${a}</span>`;
  return `<span style="color:#111827;font-weight:700;">0.0</span>`;
}

const years = {
  "2012": { d: "G12PreD", r: "G12PreR" },
  "2016": { d: "G16PreD", r: "G16PreR" },
  "2020": { d: "G20PreD", r: "G20PreR" },
  "2024": { d: "GBuildD", r: "GBuildR" }
};

function getElectionPct(p,y){ const c=years[y]; return pct2party(p[c.d],p[c.r]); }
function getElectionMargin(p,y){ const c=years[y]; return marginSigned(p[c.d],p[c.r]); }
function getAvgHHIncome(p){ const tot=numOrNull(p["DTotal_Income"]); const hh=numOrNull(p["DHouseholds"]); if(tot===null||hh===null||hh<=0) return null; return tot/hh; }
function getBachelorsPct(p){ const b=numOrNull(p["DBachelors"]); const denom=numOrNull(p["D25_or_older"]); if(b===null||denom===null||denom<=0) return null; return 100*b/denom; }
function getNonWhitePct(p){ const pop=numOrNull(p["Pop20"]); const w=numOrNull(p["DWhite"]); if(pop===null||w===null||pop<=0) return null; return 100*((pop-w)/pop); }
function getRacePct(p,key){ const pop=numOrNull(p["Pop20"]); const v=numOrNull(p[key]); if(pop===null||v===null||pop<=0) return null; return 100*v/pop; }

function getRacialPlurality(p){
  const entries=[
    {key:"White", pct:getRacePct(p,"DWhite")},
    {key:"Black", pct:getRacePct(p,"DBlack")},
    {key:"Asian", pct:getRacePct(p,"DAsian")},
    {key:"Latino", pct:getRacePct(p,"DLatino")}
  ].filter(d=>d.pct!==null);
  if(!entries.length) return null;
  entries.sort((a,b)=>b.pct-a.pct);
  const top=entries[0];
  return {group:top.key, pct:top.pct, isMajority: top.pct>=50};
}
function majorityColor(p){
  const top=getRacialPlurality(p);
  if(!top) return "#d1d5db";
  if(top.group==="White") return "#2563eb";
  if(top.group==="Black") return "#16a34a";
  if(top.group==="Asian") return "#f59e0b";
  if(top.group==="Latino") return "#dc2626";
  return "#d1d5db";
}

function getSwingMargin(p,a,b){ const m1=getElectionMargin(p,a); const m2=getElectionMargin(p,b); if(m1===null||m2===null) return null; return m2-m1; }

// Colors (Style 1)
function electionColorSignedMargin(m){
  m=numOrNull(m); if(m===null) return "#d1d5db";
  const sign = m>=0 ? "D" : "R";
  const a=Math.abs(m);
  if(a<5) return sign==="D" ? "#93c5fd" : "#fca5a5";
  if(a<10) return sign==="D" ? "#60a5fa" : "#f87171";
  if(a<20) return sign==="D" ? "#2563eb" : "#dc2626";
  return sign==="D" ? "#1e3a8a" : "#7f1d1d";
}
function swingColor(s){
  s=numOrNull(s); if(s===null) return "#d1d5db";
  if(s<-30) return "#7f1d1d";
  if(s<-20) return "#b91c1c";
  if(s<-10) return "#ef4444";
  if(s<-4) return "#fca5a5";
  if(s<0) return "#fee2e2";
  if(s===0) return "#f3f4f6";
  if(s<=4) return "#dbeafe";
  if(s<=10) return "#93c5fd";
  if(s<=20) return "#3b82f6";
  if(s<=30) return "#1d4ed8";
  return "#1e3a8a";
}

// Quantile choropleths
let incomeBreaks=null, baBreaks=null, nwBreaks=null;
function computeBreaks(getter){
  const vals=[];
  for(const f of (GEOJSON.features||[])){
    const v=getter(f.properties||{});
    if(v!==null && isFinite(v)) vals.push(v);
  }
  vals.sort((a,b)=>a-b);
  if(!vals.length) return null;
  const q=(p)=>vals[Math.min(vals.length-1, Math.max(0, Math.floor(p*(vals.length-1))))];
  const breaks=[q(0.2),q(0.4),q(0.6),q(0.8)];
  const uniq=[];
  for(const b of breaks){ if(!uniq.length || Math.abs(b-uniq[uniq.length-1])>1e-9) uniq.push(b); }
  return uniq;
}
function choroplethColor(v, breaks, palette){
  v=numOrNull(v);
  if(v===null || !breaks || !breaks.length) return "#d1d5db";
  let idx=0; while(idx<breaks.length && v>breaks[idx]) idx++;
  return palette[Math.min(idx, palette.length-1)];
}
const incomePalette=["#e5e7eb","#cbd5e1","#94a3b8","#64748b","#334155"];
const pctPalette=["#eff6ff","#dbeafe","#93c5fd","#3b82f6","#1e3a8a"];

