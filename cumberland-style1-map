function styleFeature(feature){
  const p=(feature&&feature.properties)?feature.properties:{};
  let fill="#d1d5db";
  if(currentMode==="e2012") fill=electionColorSignedMargin(getElectionMargin(p,"2012"));
  else if(currentMode==="e2016") fill=electionColorSignedMargin(getElectionMargin(p,"2016"));
  else if(currentMode==="e2020") fill=electionColorSignedMargin(getElectionMargin(p,"2020"));
  else if(currentMode==="e2024") fill=electionColorSignedMargin(getElectionMargin(p,"2024"));
  else if(currentMode==="s12_16") fill=swingColor(getSwingMargin(p,"2012","2016"));
  else if(currentMode==="s16_20") fill=swingColor(getSwingMargin(p,"2016","2020"));
  else if(currentMode==="s20_24") fill=swingColor(getSwingMargin(p,"2020","2024"));
  else if(currentMode==="s12_20") fill=swingColor(getSwingMargin(p,"2012","2020"));
  else if(currentMode==="s16_24") fill=swingColor(getSwingMargin(p,"2016","2024"));
  else if(currentMode==="s12_24") fill=swingColor(getSwingMargin(p,"2012","2024"));
  else if(currentMode==="inc") fill=choroplethColor(getAvgHHIncome(p), incomeBreaks, incomePalette);
  else if(currentMode==="ba") fill=choroplethColor(getBachelorsPct(p), baBreaks, pctPalette);
  else if(currentMode==="nw") fill=choroplethColor(getNonWhitePct(p), nwBreaks, pctPalette);
  else if(currentMode==="maj") fill=majorityColor(p);

  return { color:"rgba(17,24,39,0.55)", weight:1, fillColor:fill, fillOpacity:0.78 };
}

